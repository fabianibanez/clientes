// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      UserRole @default(CLIENT)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([clientId])
}

enum UserRole {
  ADMIN
  CLIENT
}

model Client {
  id          String      @id @default(cuid())
  name        String
  company     String?
  email       String      @unique
  phone       String?
  status      ClientStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  users       User[]
  projects    Project[]
  payments    Payment[]
  documents   Document[]

  @@index([email])
  @@index([status])
}

enum ClientStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

model Project {
  id                String          @id @default(cuid())
  name              String
  description       String?
  status            ProjectStatus   @default(ACTIVE)
  startDate         DateTime?
  estimatedEndDate  DateTime?
  actualEndDate     DateTime?
  clientId          String
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tasks             Task[]
  payments          Payment[]
  documents         Document[]

  @@index([clientId])
  @@index([status])
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model Task {
  id          String     @id @default(cuid())
  name        String
  description String?
  status      TaskStatus @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  comments    Comment[]

  @@index([projectId])
  @@index([status])
  @@index([priority])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model Payment {
  id              String          @id @default(cuid())
  amount          Float
  description     String?
  status          PaymentStatus   @default(PENDING)
  paymentMethod   String?
  paymentDate     DateTime?
  dueDate         DateTime?
  invoiceNumber   String?
  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  documents       Document[]

  @@index([clientId])
  @@index([projectId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

model Document {
  id          String   @id @default(cuid())
  name        String
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  paymentId   String?
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([paymentId])
}